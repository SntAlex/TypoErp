{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=typoerp;Username=postgres;Password=postgres"
  },
  "ProductsStorage": {
    "RootPath": "./storage/products",
    "ProductIdFileName": ".typoerp_id",
    "MaxPrimaryTagLength": 200,
    "MaxProductsPerPrimaryTag": 1000,
    "MaxArticleLength": 60,
    "AllowedImageExtensions": [ ".jpg", ".jpeg", ".png", ".tif", ".tiff", ".webp" ],
    "AllowedVideoExtensions": [ ".mp4", ".mov", ".mkv", ".avi", ".webm" ],
    "IgnoredFilePatterns": [ ".typoerp_id", "thumbs.db", "desktop.ini", ".ds_store", "~$*", ".*" ]
  },
  "DefaultAdmin": {
    "Username": "admin",
    "DisplayName": "Главный Администратор",
    "Password": "Admin123!"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}