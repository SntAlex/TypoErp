@page "/products"
@attribute [Authorize]
@implements IDisposable
@inject IProductCatalogQueryService CatalogQueryService
@inject IProductSyncService SyncService
@inject IProductsWorkspaceLockService WorkspaceLockService
@inject IProductsWorkspaceCircuitSession CircuitSession
@inject ISnackbar Snackbar

<PageTitle>Товары — TypoErp</PageTitle>

@if (!_canViewProducts)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-4">
        У вашей учетной записи нет разрешения на просмотр раздела «Товары». Обратитесь к администратору.
    </MudAlert>
}
else
{
    <ProductsWorkspaceLockBanner />

    <MudStack Spacing="3">
        @* Заголовок, сводные счетчики, кнопка создания товара и кнопка синхронизации с диском *@
        <MudPaper Elevation="1" Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h5">Рабочее пространство «Товары»</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Корень хранилища: <code>@(_lookups?.StorageRootPath ?? "—")</code>
                    </MudText>
                </MudStack>

                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">
                        Всего: @_totalAllCount
                    </MudChip>
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined">
                        Валидных: @_totalValidCount
                    </MudChip>
                    <MudChip T="string" Color="@(_totalInvalidCount > 0 ? Color.Error : Color.Default)" Variant="Variant.Outlined">
                        С ошибками / черновиков: @_totalInvalidCount
                    </MudChip>

                    @if (_canEditProducts)
                    {
                        <MudTooltip Text="@GetEditButtonTooltip()">
                            <span>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Success"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           Disabled="@(!CanExecuteWriteOperation)"
                                           OnClick="OpenCreateProductDialog">
                                    Создать товар / черновик
                                </MudButton>
                            </span>
                        </MudTooltip>
                    }

                    @if (_canSyncProducts)
                    {
                        <MudTooltip Text="@GetSyncButtonTooltip()">
                            <span>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Sync"
                                           Disabled="@(!CanExecuteSyncOperation)"
                                           OnClick="RunSynchronizationAsync">
                                    @(_isSyncing ? "Синхронизация..." : "Синхронизировать с диском")
                                </MudButton>
                            </span>
                        </MudTooltip>
                    }
                </MudStack>
            </MudStack>

            @if (_lastSyncResult is not null)
            {
                <MudAlert Severity="@(_lastSyncResult.NormalizationConflictsCount > 0 || _lastSyncResult.InvalidProducts > 0 ? Severity.Warning : Severity.Success)"
                          Variant="Variant.Outlined"
                          Dense="true"
                          ShowCloseIcon="true"
                          CloseIconClicked="ClearLastSyncResult"
                          Class="mt-3">
                    <b>Отчет синхронизации (@_lastSyncResult.SynchronizedAtUtc.ToLocalTime().ToString("HH:mm:ss")):</b>
                    Всего товаров: @_lastSyncResult.TotalProducts (валидных: @_lastSyncResult.ValidProducts, проблемных: @_lastSyncResult.InvalidProducts) •
                    Добавлено: @_lastSyncResult.AddedProducts, обновлено: @_lastSyncResult.UpdatedProducts, удалено: @_lastSyncResult.DeletedProducts •
                    Авто-нормализовано имен на диске: @_lastSyncResult.AutoNormalizedItemsCount, конфликтов нормализации: @_lastSyncResult.NormalizationConflictsCount •
                    Файлов записано/изменено: @_lastSyncResult.AddedOrUpdatedFilesCount, без изменений (по XxHash64): @_lastSyncResult.UnchangedFilesCount.
                </MudAlert>
            }
        </MudPaper>

        @* Навигационные вкладки раздела «Товары»: 1) Каталог товаров, 2) Категории, Форматы и Теги *@
        <MudTabs @bind-ActivePanelIndex="_activeTabIndex"
                 Elevation="1"
                 Rounded="true"
                 ApplyEffectsToContainer="true"
                 Color="Color.Primary">
            <MudTabPanel Text="Каталог товаров" Icon="@Icons.Material.Filled.TableView">
                <MudStack Spacing="3" Class="pt-3">
                    @* Панель фильтрации и поиска *@
                    <MudPaper Elevation="1" Class="pa-4">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudTextField T="string"
                                              Value="@_searchText"
                                              ValueChanged="OnSearchChangedAsync"
                                              Label="Поиск (артикул, первичный тег, категория, формат, файл)"
                                              Placeholder="Например: 45к котики или card"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                              Clearable="true"
                                              DebounceInterval="250" />
                            </MudItem>

                            <MudItem xs="12" sm="6" md="2">
                                <MudSelect T="ProductValidityFilter"
                                           Value="@_validityFilter"
                                           ValueChanged="OnValidityFilterChangedAsync"
                                           Label="Статус валидности"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense">
                                    <MudSelectItem T="ProductValidityFilter" Value="ProductValidityFilter.All">Все товары</MudSelectItem>
                                    <MudSelectItem T="ProductValidityFilter" Value="ProductValidityFilter.ValidOnly">Только валидные</MudSelectItem>
                                    <MudSelectItem T="ProductValidityFilter" Value="ProductValidityFilter.InvalidOnly">Только с ошибками / черновики</MudSelectItem>
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <MudSelect T="Guid?"
                                           Value="@_selectedPrimaryTagId"
                                           ValueChanged="OnPrimaryTagChangedAsync"
                                           Label="Первичный тег (папка 1-го уровня)"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Clearable="true">
                                    @if (_lookups is not null)
                                    {
                                        @foreach (var tag in _lookups.PrimaryTags)
                                        {
                                            <MudSelectItem T="Guid?" Value="@((Guid?)tag.Id)">
                                                @tag.Name (@tag.ProductsCount)
                                            </MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <MudSelect T="Guid?"
                                           Value="@_selectedCategoryId"
                                           ValueChanged="OnCategoryChangedAsync"
                                           Label="Категория (префикс сборки)"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Clearable="true">
                                    @if (_lookups is not null)
                                    {
                                        @foreach (var cat in _lookups.Categories)
                                        {
                                            <MudSelectItem T="Guid?" Value="@((Guid?)cat.Id)">
                                                @cat.DisplayLabel (@cat.ProductsCount)
                                            </MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <MudSelect T="Guid?"
                                           Value="@_selectedFormatId"
                                           ValueChanged="OnFormatChangedAsync"
                                           Label="Формат (внутри категории)"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Clearable="true">
                                    @foreach (var fmt in GetAvailableFormats())
                                    {
                                        <MudSelectItem T="Guid?" Value="@((Guid?)fmt.Id)">
                                            @fmt.DisplayLabel (@fmt.ProductsCount)
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="4">
                                <MudSelect T="Guid"
                                           SelectedValues="@_selectedSecondaryTagIds"
                                           SelectedValuesChanged="OnSecondaryTagsChangedAsync"
                                           Label="Непервичные теги (включая унаследованные)"
                                           MultiSelection="true"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           ToStringFunc="@GetSecondaryTagNameById">
                                    @if (_lookups is not null)
                                    {
                                        @foreach (var secTag in _lookups.SecondaryTags)
                                        {
                                            <MudSelectItem T="Guid" Value="@secTag.Id">
                                                @secTag.Name
                                            </MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <MudSelect T="ProductValidationError?"
                                           Value="@_selectedValidationError"
                                           ValueChanged="OnValidationErrorChangedAsync"
                                           Label="Конкретная ошибка валидации"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Clearable="true">
                                    @foreach (var err in ProductValidationErrorInfo.AllErrors)
                                    {
                                        var desc = ProductValidationErrorInfo.Describe(err);
                                        <MudSelectItem T="ProductValidationError?" Value="@((ProductValidationError?)err)">
                                            @desc.ShortTitle
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="2">
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Secondary"
                                           FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.FilterAltOff"
                                           Disabled="@(!HasActiveFilters)"
                                           OnClick="ResetFiltersAsync">
                                    Сбросить
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    @* Панель массовых операций (Bulk CRUD Toolbar) *@
                    @if (_selectedProducts.Count > 0)
                    {
                        <MudPaper Elevation="2" Class="pa-3" Style="border-left: 4px solid var(--mud-palette-primary);">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">
                                        Выбрано товаров: @_selectedProducts.Count
                                    </MudChip>
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               Color="Color.Secondary"
                                               OnClick="ClearSelection">
                                        Снять выделение
                                    </MudButton>
                                </MudStack>

                                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.DriveFileMove"
                                               Disabled="@(!CanExecuteWriteOperation)"
                                               OnClick="OpenBulkMoveDialog">
                                        Перенести в первичный тег...
                                    </MudButton>

                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               Color="Color.Secondary"
                                               StartIcon="@Icons.Material.Filled.Label"
                                               Disabled="@(!CanExecuteWriteOperation)"
                                               OnClick="OpenBulkTagsDialog">
                                        Непервичные теги...
                                    </MudButton>

                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Filled"
                                               Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.DeleteSweep"
                                               Disabled="@(!CanExecuteWriteOperation)"
                                               OnClick="OpenBulkDeleteDialog">
                                        Удалить выбранные (@_selectedProducts.Count)
                                    </MudButton>
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    }

                    @* Главная таблица товаров MudDataGrid *@
                    <MudPaper Elevation="1">
                        <MudDataGrid @ref="_dataGrid"
                                     T="ProductCatalogItemDto"
                                     ServerData="LoadServerDataAsync"
                                     MultiSelection="true"
                                     @bind-SelectedItems="_selectedProducts"
                                     Hover="true"
                                     Dense="true"
                                     Striped="true"
                                     FixedHeader="true">
                            <Columns>
                                <SelectColumn T="ProductCatalogItemDto" />
                                <HierarchyColumn T="ProductCatalogItemDto" />

                                <TemplateColumn T="ProductCatalogItemDto" Title="Статус" SortBy="@(_ => nameof(ProductCatalogSortField.Validity))">
                                    <CellTemplate>
                                        @if (context.Item.IsValid)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">
                                                Валиден
                                            </MudChip>
                                        }
                                        else if (context.Item.IsDraftOnly)
                                        {
                                            <MudTooltip Text="@ProductValidationErrorInfo.Describe(ProductValidationError.MissingAssemblyFiles).Description">
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">
                                                    Черновик
                                                </MudChip>
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                                @foreach (var err in context.Item.ValidationErrors)
                                                {
                                                    var desc = ProductValidationErrorInfo.Describe(err);
                                                    <MudTooltip Text="@desc.Description">
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">
                                                            @desc.ShortTitle
                                                        </MudChip>
                                                    </MudTooltip>
                                                }
                                            </MudStack>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>

                                <TemplateColumn T="ProductCatalogItemDto" Title="Первичный тег" SortBy="@(_ => nameof(ProductCatalogSortField.PrimaryTag))">
                                    <CellTemplate>
                                        @if (!string.IsNullOrWhiteSpace(context.Item.PrimaryTagName))
                                        {
                                            <MudText Typo="Typo.body2">@context.Item.PrimaryTagName</MudText>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Error">Вне первичного тега (корень)</MudText>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>

                                <TemplateColumn T="ProductCatalogItemDto" Title="Артикул" SortBy="@(_ => nameof(ProductCatalogSortField.Article))">
                                    <CellTemplate>
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body2"><b>@context.Item.Article</b></MudText>
                                            @if (!string.Equals(context.Item.Article, context.Item.NormalizedArticle, StringComparison.Ordinal))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Warning">
                                                    Норм.: @context.Item.NormalizedArticle
                                                </MudText>
                                            }
                                        </MudStack>
                                    </CellTemplate>
                                </TemplateColumn>

                                <TemplateColumn T="ProductCatalogItemDto" Title="Категория" SortBy="@(_ => nameof(ProductCatalogSortField.Category))">
                                    <CellTemplate>
                                        <MudText Typo="Typo.body2">@context.Item.CategoryLabel</MudText>
                                    </CellTemplate>
                                </TemplateColumn>

                                <TemplateColumn T="ProductCatalogItemDto" Title="Формат" SortBy="@(_ => nameof(ProductCatalogSortField.Format))">
                                    <CellTemplate>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                            @(context.Item.FormatCode ?? "—")
                                        </MudChip>
                                    </CellTemplate>
                                </TemplateColumn>

                                <TemplateColumn T="ProductCatalogItemDto" Title="Непервичные теги" Sortable="false">
                                    <CellTemplate>
                                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                            @foreach (var directTag in context.Item.SecondaryTags)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                                    @directTag
                                                </MudChip>
                                            }
                                            @foreach (var inheritedTag in context.Item.InheritedSecondaryTags)
                                            {
                                                <MudTooltip Text="Унаследован от категории или формата">
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">
                                                        @inheritedTag
                                                    </MudChip>
                                                </MudTooltip>
                                            }
                                        </MudStack>
                                    </CellTemplate>
                                </TemplateColumn>

                                <TemplateColumn T="ProductCatalogItemDto" Title="Файлы (Обл / Вид / Сб)" SortBy="@(_ => nameof(ProductCatalogSortField.FilesCount))">
                                    <CellTemplate>
                                        <MudText Typo="Typo.body2">
                                            @context.Item.CoversCount / @context.Item.VideoCoversCount / <b>@context.Item.AssemblyFilesCount</b>
                                        </MudText>
                                    </CellTemplate>
                                </TemplateColumn>

                                <TemplateColumn T="ProductCatalogItemDto" Title="Обновлен" SortBy="@(_ => nameof(ProductCatalogSortField.UpdatedAtUtc))">
                                    <CellTemplate>
                                        <MudText Typo="Typo.caption">
                                            @context.Item.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                        </MudText>
                                    </CellTemplate>
                                </TemplateColumn>

                                @if (_canEditProducts)
                                {
                                    <TemplateColumn T="ProductCatalogItemDto" Title="Действия" Sortable="false">
                                        <CellTemplate>
                                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                                <MudTooltip Text="@(context.Item.IsValid ? "Редактировать товар и файлы" : "Починить ошибки товара и файлов на диске")">
                                                    <span>
                                                        <MudIconButton Icon="@(context.Item.IsValid ? Icons.Material.Filled.Edit : Icons.Material.Filled.Build)"
                                                                       Size="Size.Small"
                                                                       Color="@(context.Item.IsValid ? Color.Primary : Color.Warning)"
                                                                       Disabled="@(!CanExecuteWriteOperation)"
                                                                       OnClick="@(() => OpenEditProductDialogAsync(context.Item))" />
                                                    </span>
                                                </MudTooltip>

                                                <MudTooltip Text="Удалить товар с диска и из БД">
                                                    <span>
                                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                                       Size="Size.Small"
                                                                       Color="Color.Error"
                                                                       Disabled="@(!CanExecuteWriteOperation)"
                                                                       OnClick="@(() => OpenSingleDeleteDialog(context.Item))" />
                                                    </span>
                                                </MudTooltip>
                                            </MudStack>
                                        </CellTemplate>
                                    </TemplateColumn>
                                }
                            </Columns>

                            <ChildRowContent>
                                <MudCard Elevation="0" Class="pa-3" Style="background-color: var(--mud-palette-background-grey);">
                                    <MudStack Spacing="2">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                            <MudText Typo="Typo.subtitle2">
                                                Детали товара • ProductId (<code>.typoerp_id</code>): <code>@context.Item.Id</code>
                                            </MudText>

                                            @if (_canEditProducts)
                                            {
                                                <MudButton Size="Size.Small"
                                                           Variant="Variant.Filled"
                                                           Color="@(context.Item.IsValid ? Color.Primary : Color.Warning)"
                                                           StartIcon="@(context.Item.IsValid ? Icons.Material.Filled.Edit : Icons.Material.Filled.Build)"
                                                           Disabled="@(!CanExecuteWriteOperation)"
                                                           OnClick="@(() => OpenEditProductDialogAsync(context.Item))">
                                                    @(context.Item.IsValid ? "Редактировать товар" : "Починить товар / переименовать файлы")
                                                </MudButton>
                                            }
                                        </MudStack>

                                        @if (!context.Item.IsValid)
                                        {
                                            <MudAlert Severity="@(context.Item.IsDraftOnly ? Severity.Info : Severity.Error)" Variant="Variant.Outlined" Dense="true">
                                                <MudText Typo="Typo.subtitle2" Class="mb-1">Причины невалидности товара:</MudText>
                                                <ul class="ma-0 pl-4">
                                                    @foreach (var err in context.Item.ValidationErrors)
                                                    {
                                                        var desc = ProductValidationErrorInfo.Describe(err);
                                                        <li><b>@desc.ShortTitle:</b> @desc.Description</li>
                                                    }
                                                </ul>
                                            </MudAlert>
                                        }

                                        @if (context.Item.Files.Count == 0)
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                В папке товара пока нет неигнорируемых файлов.
                                            </MudText>
                                        }
                                        else
                                        {
                                            <MudSimpleTable Dense="true" Hover="true" Bordered="true" Style="overflow-x: auto;">
                                                <thead>
                                                    <tr>
                                                        <th>Имя файла на диске</th>
                                                        <th>Тип</th>
                                                        <th>Префикс</th>
                                                        <th>Расширение</th>
                                                        <th>Размер</th>
                                                        <th>XxHash64</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var file in context.Item.Files)
                                                    {
                                                        <tr>
                                                            <td><code>@file.FileName</code></td>
                                                            <td>@FormatFileKind(file.Kind)</td>
                                                            <td><code>@file.Prefix</code></td>
                                                            <td><code>@file.Extension</code></td>
                                                            <td>@FormatFileSize(file.SizeBytes)</td>
                                                            <td><code>@file.XxHash64</code></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </MudSimpleTable>
                                        }
                                    </MudStack>
                                </MudCard>
                            </ChildRowContent>

                            <NoRecordsContent>
                                <MudText Typo="Typo.body1" Class="pa-4">
                                    Товары по заданным условиям фильтрации не найдены.
                                </MudText>
                            </NoRecordsContent>

                            <PagerContent>
                                <MudDataGridPager T="ProductCatalogItemDto" PageSizeOptions="@(new[] { 10, 25, 50, 100 })" />
                            </PagerContent>
                        </MudDataGrid>
                    </MudPaper>
                </MudStack>
            </MudTabPanel>

            <MudTabPanel Text="Категории, Форматы и Теги" Icon="@Icons.Material.Filled.AccountTree">
                <div class="pt-3">
                    <ProductsTaxonomyPanel @ref="_taxonomyPanel"
                                           SessionId="@CircuitSession.SessionId"
                                           CanEditProducts="@_canEditProducts"
                                           IsLockHeldByCurrentSession="@IsLockHeldByCurrentSession"
                                           IsStorageRootAccessible="@(_lookups?.IsStorageRootAccessible ?? true)"
                                           OnDataModified="HandleTaxonomyModifiedAsync"
                                           OnFilterByCategory="FilterCatalogByCategoryAsync"
                                           OnFilterByFormat="FilterCatalogByFormatAsync"
                                           OnFilterByPrimaryTag="FilterCatalogByPrimaryTagAsync"
                                           OnFilterBySecondaryTag="FilterCatalogBySecondaryTagAsync" />
                </div>
            </MudTabPanel>
        </MudTabs>
    </MudStack>

    @* Диалоги создания/редактирования/починки и массовых операций *@
    <ProductEditDialog @bind-Visible="_isEditDialogOpen"
                       EditingProduct="_editingProduct"
                       SessionId="@CircuitSession.SessionId"
                       AvailablePrimaryTags="@(_lookups?.PrimaryTags ?? [])"
                       AvailableSecondaryTags="@(_lookups?.SecondaryTags ?? [])"
                       OnSaved="HandleProductSavedAsync" />

    <BulkMoveProductsDialog @bind-Visible="_isBulkMoveDialogOpen"
                            SessionId="@CircuitSession.SessionId"
                            ProductIds="@(_selectedProducts.Select(p => p.Id).ToList())"
                            AvailablePrimaryTags="@(_lookups?.PrimaryTags ?? [])"
                            OnCompleted="HandleBulkMoveCompletedAsync" />

    <BulkSecondaryTagsDialog @bind-Visible="_isBulkTagsDialogOpen"
                             SessionId="@CircuitSession.SessionId"
                             ProductIds="@(_selectedProducts.Select(p => p.Id).ToList())"
                             AvailableSecondaryTags="@(_lookups?.SecondaryTags ?? [])"
                             OnCompleted="HandleBulkCountCompletedAsync" />

    <ConfirmDeleteProductsDialog @bind-Visible="_isDeleteDialogOpen"
                                 SessionId="@CircuitSession.SessionId"
                                 ProductsToDelete="@_productsPendingDeletion"
                                 OnDeleted="HandleBulkCountCompletedAsync" />
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private MudDataGrid<ProductCatalogItemDto>? _dataGrid;
    private ProductsTaxonomyPanel? _taxonomyPanel;
    private ProductCatalogLookups? _lookups;
    private ProductSyncResult? _lastSyncResult;

    private int _activeTabIndex;
    private bool _canViewProducts;
    private bool _canEditProducts;
    private bool _canSyncProducts;
    private bool _isSyncing;

    private int _totalAllCount;
    private int _totalValidCount;
    private int _totalInvalidCount;

    private string? _searchText;
    private ProductValidityFilter _validityFilter = ProductValidityFilter.All;
    private Guid? _selectedPrimaryTagId;
    private Guid? _selectedCategoryId;
    private Guid? _selectedFormatId;
    private IReadOnlyCollection<Guid> _selectedSecondaryTagIds = [];
    private ProductValidationError? _selectedValidationError;

    private HashSet<ProductCatalogItemDto> _selectedProducts = [];

    private bool _isEditDialogOpen;
    private ProductCatalogItemDto? _editingProduct;
    private bool _isBulkMoveDialogOpen;
    private bool _isBulkTagsDialogOpen;
    private bool _isDeleteDialogOpen;
    private IReadOnlyList<ProductCatalogItemDto> _productsPendingDeletion = [];

    private bool IsLockHeldByCurrentSession =>
        WorkspaceLockService.IsHeldBySession(CircuitSession.SessionId);

    private bool CanExecuteWriteOperation =>
        _canEditProducts
        && IsLockHeldByCurrentSession
        && _lookups?.IsStorageRootAccessible == true
        && !_isSyncing;

    private bool CanExecuteSyncOperation =>
        _canSyncProducts
        && !_isSyncing
        && IsLockHeldByCurrentSession
        && _lookups?.IsStorageRootAccessible == true;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchText)
        || _validityFilter != ProductValidityFilter.All
        || _selectedPrimaryTagId.HasValue
        || _selectedCategoryId.HasValue
        || _selectedFormatId.HasValue
        || _selectedSecondaryTagIds.Count > 0
        || _selectedValidationError.HasValue;

    protected override async Task OnInitializedAsync()
    {
        CircuitSession.StateChanged += HandleLockStateChanged;

        if (AuthenticationStateTask is not null)
        {
            var authState = await AuthenticationStateTask;
            var user = authState.User;

            _canViewProducts = user.HasPermission(AppPermission.ProductsView);
            _canEditProducts = user.HasPermission(AppPermission.ProductsEdit);
            _canSyncProducts = user.HasPermission(AppPermission.ProductsSync);
        }

        if (_canViewProducts)
            await RefreshLookupsAsync();
    }

    public void Dispose()
    {
        CircuitSession.StateChanged -= HandleLockStateChanged;
    }

    private void HandleLockStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ClearLastSyncResult()
    {
        _lastSyncResult = null;
    }

    private void ClearSelection()
    {
        _selectedProducts.Clear();
    }

    private void OpenBulkMoveDialog()
    {
        if (!EnsureCanWriteOrNotify())
            return;

        _isBulkMoveDialogOpen = true;
    }

    private void OpenBulkTagsDialog()
    {
        if (!EnsureCanWriteOrNotify())
            return;

        _isBulkTagsDialogOpen = true;
    }

    private async Task RefreshLookupsAsync()
    {
        _lookups = await CatalogQueryService.GetFilterLookupsAsync();
        _totalAllCount = _lookups.TotalProductsCount;
        _totalValidCount = _lookups.ValidProductsCount;
        _totalInvalidCount = _lookups.InvalidProductsCount;

        if (
            _selectedPrimaryTagId.HasValue
            && !_lookups.PrimaryTags.Any(t => t.Id == _selectedPrimaryTagId.Value)
        )
            _selectedPrimaryTagId = null;

        if (
            _selectedCategoryId.HasValue
            && !_lookups.Categories.Any(c => c.Id == _selectedCategoryId.Value)
        )
            _selectedCategoryId = null;

        if (
            _selectedFormatId.HasValue
            && !_lookups.Formats.Any(f => f.Id == _selectedFormatId.Value)
        )
            _selectedFormatId = null;

        if (_selectedSecondaryTagIds.Count > 0)
        {
            var validSecIds = _lookups.SecondaryTags.Select(t => t.Id).ToHashSet();
            _selectedSecondaryTagIds = _selectedSecondaryTagIds
                .Where(validSecIds.Contains)
                .ToList();
        }
    }

    private async Task<GridData<ProductCatalogItemDto>> LoadServerDataAsync(
        GridState<ProductCatalogItemDto> state,
        CancellationToken cancellationToken
    )
    {
        var sortDef = state.SortDefinitions.FirstOrDefault();
        var sortField = ResolveSortField(sortDef?.SortBy);
        var sortDescending = sortDef?.Descending ?? false;

        var filter = new ProductCatalogFilter(
            SearchText: _searchText,
            Validity: _validityFilter,
            PrimaryTagId: _selectedPrimaryTagId,
            CategoryId: _selectedCategoryId,
            FormatId: _selectedFormatId,
            SecondaryTagIds: _selectedSecondaryTagIds,
            ValidationError: _selectedValidationError,
            SortBy: sortField,
            SortDescending: sortDescending,
            Page: state.Page,
            PageSize: state.PageSize
        );

        var pageResult = await CatalogQueryService.QueryProductsAsync(filter, cancellationToken);

        _totalAllCount = pageResult.TotalAllProductsCount;
        _totalValidCount = pageResult.TotalValidProductsCount;
        _totalInvalidCount = pageResult.TotalInvalidProductsCount;

        return new GridData<ProductCatalogItemDto>
        {
            Items = pageResult.Items,
            TotalItems = pageResult.TotalMatchedCount,
        };
    }

    private void OpenCreateProductDialog()
    {
        if (!EnsureCanWriteOrNotify())
            return;

        _editingProduct = null;
        _isEditDialogOpen = true;
    }

    private async Task OpenEditProductDialogAsync(ProductCatalogItemDto item)
    {
        if (!EnsureCanWriteOrNotify())
            return;

        var freshProduct = await CatalogQueryService.GetProductByIdAsync(item.Id);
        _editingProduct = freshProduct ?? item;
        _isEditDialogOpen = true;
    }

    private void OpenSingleDeleteDialog(ProductCatalogItemDto item)
    {
        if (!EnsureCanWriteOrNotify())
            return;

        _productsPendingDeletion = [item];
        _isDeleteDialogOpen = true;
    }

    private void OpenBulkDeleteDialog()
    {
        if (!EnsureCanWriteOrNotify() || _selectedProducts.Count == 0)
            return;

        _productsPendingDeletion = _selectedProducts.ToList();
        _isDeleteDialogOpen = true;
    }

    private bool EnsureCanWriteOrNotify()
    {
        if (!IsLockHeldByCurrentSession)
        {
            Snackbar.Add(
                "Сначала захватите блокировку раздела «Товары» на верхней панели.",
                Severity.Warning
            );
            return false;
        }

        if (_lookups?.IsStorageRootAccessible != true)
        {
            Snackbar.Add(
                "Корневой путь файлового хранилища недоступен.",
                Severity.Error
            );
            return false;
        }

        return true;
    }

    private async Task HandleProductSavedAsync(ProductMutationResult _)
    {
        await ReloadCatalogDataAsync();
    }

    private async Task HandleBulkMoveCompletedAsync(BulkMoveProductsResult _)
    {
        await ReloadCatalogDataAsync();
    }

    private async Task HandleBulkCountCompletedAsync(int _)
    {
        await ReloadCatalogDataAsync();
    }

    private async Task HandleTaxonomyModifiedAsync()
    {
        await RefreshLookupsAsync();
        if (_dataGrid is not null)
            await _dataGrid.ReloadServerData();
    }

    private async Task ReloadCatalogDataAsync()
    {
        _selectedProducts.Clear();
        await RefreshLookupsAsync();
        if (_dataGrid is not null)
            await _dataGrid.ReloadServerData();
        if (_taxonomyPanel is not null)
            await _taxonomyPanel.ReloadAsync();
    }

    private async Task FilterCatalogByCategoryAsync(Guid categoryId)
    {
        _selectedCategoryId = categoryId;
        _selectedFormatId = null;
        _activeTabIndex = 0;

        if (_dataGrid is not null)
            await _dataGrid.ReloadServerData();
    }

    private async Task FilterCatalogByFormatAsync((Guid CategoryId, Guid FormatId) target)
    {
        _selectedCategoryId = target.CategoryId;
        _selectedFormatId = target.FormatId;
        _activeTabIndex = 0;

        if (_dataGrid is not null)
            await _dataGrid.ReloadServerData();
    }

    private async Task FilterCatalogByPrimaryTagAsync(Guid primaryTagId)
    {
        _selectedPrimaryTagId = primaryTagId;
        _activeTabIndex = 0;

        if (_dataGrid is not null)
            await _dataGrid.ReloadServerData();
    }

    private async Task FilterCatalogBySecondaryTagAsync(Guid secondaryTagId)
    {
        _selectedSecondaryTagIds = [secondaryTagId];
        _activeTabIndex = 0;

        if (_dataGrid is not null)
            await _dataGrid.ReloadServerData();
    }

    private async Task RunSynchronizationAsync()
    {
        if (!CanExecuteSyncOperation)
            return;

        _isSyncing = true;
        try
        {
            _lastSyncResult = await SyncService.SynchronizeAsync(CircuitSession.SessionId);
            await ReloadCatalogDataAsync();

            Snackbar.Add(
                $"Синхронизация завершена: обработано {_lastSyncResult.TotalProducts} товаров.",
                Severity.Success
            );
        }
        catch (ProductsWorkspaceLockException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка синхронизации: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSyncing = false;
        }
    }

    private async Task OnSearchChangedAsync(string? value)
    {
        _searchText = value;
        if (_dataGrid is not null)
            await _dataGrid.ReloadServerData();
    }

    private async Task OnValidityFilterChangedAsync(ProductValidityFilter value)
    {
        _validityFilter = value;
        if (_dataGrid is not null)
            await _dataGrid.ReloadServerData();
    }

    private async Task OnPrimaryTagChangedAsync(Guid? value)
    {
        _selectedPrimaryTagId = value;
        if (_dataGrid is not null)
            await _dataGrid.ReloadServerData();
    }

    private async Task OnCategoryChangedAsync(Guid? value)
    {
        _selectedCategoryId = value;

        if (
            _selectedFormatId.HasValue
            && _lookups is not null
            && !_lookups.Formats.Any(f =>
                f.Id == _selectedFormatId.Value
                && (!value.HasValue || f.CategoryId == value.Value)
            )
        )
        {
            _selectedFormatId = null;
        }

        if (_dataGrid is not null)
            await _dataGrid.ReloadServerData();
    }

    private async Task OnFormatChangedAsync(Guid? value)
    {
        _selectedFormatId = value;
        if (_dataGrid is not null)
            await _dataGrid.ReloadServerData();
    }

    private async Task OnSecondaryTagsChangedAsync(IEnumerable<Guid> values)
    {
        _selectedSecondaryTagIds = values.ToList();
        if (_dataGrid is not null)
            await _dataGrid.ReloadServerData();
    }

    private async Task OnValidationErrorChangedAsync(ProductValidationError? value)
    {
        _selectedValidationError = value;
        if (_dataGrid is not null)
            await _dataGrid.ReloadServerData();
    }

    private async Task ResetFiltersAsync()
    {
        _searchText = null;
        _validityFilter = ProductValidityFilter.All;
        _selectedPrimaryTagId = null;
        _selectedCategoryId = null;
        _selectedFormatId = null;
        _selectedSecondaryTagIds = [];
        _selectedValidationError = null;

        if (_dataGrid is not null)
            await _dataGrid.ReloadServerData();
    }

    private IEnumerable<FormatLookupDto> GetAvailableFormats()
    {
        if (_lookups is null)
            return [];

        return _selectedCategoryId.HasValue
            ? _lookups.Formats.Where(f => f.CategoryId == _selectedCategoryId.Value)
            : _lookups.Formats;
    }

    private string GetSecondaryTagNameById(Guid id)
    {
        return _lookups?.SecondaryTags.FirstOrDefault(t => t.Id == id)?.Name ?? id.ToString();
    }

    private string GetEditButtonTooltip()
    {
        if (_lookups is { IsStorageRootAccessible: false })
            return "Корневой путь файлового хранилища недоступен";

        if (!IsLockHeldByCurrentSession)
            return "Для создания, редактирования или удаления товаров сначала захватите блокировку раздела на верхней панели";

        return "Создать новый товар или пустой черновик на диске и в БД";
    }

    private string GetSyncButtonTooltip()
    {
        if (_lookups is { IsStorageRootAccessible: false })
            return "Корневой путь файлового хранилища недоступен";

        if (!IsLockHeldByCurrentSession)
            return "Для запуска синхронизации необходимо сначала захватить блокировку раздела «Товары» на верхней панели";

        return "Сканировать папки на диске, авто-нормализовать имена и сверить хэши XxHash64 с БД";
    }

    private static ProductCatalogSortField ResolveSortField(string? sortBy) =>
        sortBy switch
        {
            nameof(ProductCatalogSortField.PrimaryTag) => ProductCatalogSortField.PrimaryTag,
            nameof(ProductCatalogSortField.Category) => ProductCatalogSortField.Category,
            nameof(ProductCatalogSortField.Format) => ProductCatalogSortField.Format,
            nameof(ProductCatalogSortField.Validity) => ProductCatalogSortField.Validity,
            nameof(ProductCatalogSortField.FilesCount) => ProductCatalogSortField.FilesCount,
            nameof(ProductCatalogSortField.UpdatedAtUtc) => ProductCatalogSortField.UpdatedAtUtc,
            _ => ProductCatalogSortField.Article,
        };

    private static string FormatFileKind(ProductFileKind kind) =>
        kind switch
        {
            ProductFileKind.Cover => "Обложка (cover)",
            ProductFileKind.VideoCover => "Видеообложка (video)",
            ProductFileKind.AssemblyFile => "Файл сборки",
            _ => "Игнорируемый",
        };

    private static string FormatFileSize(long sizeBytes)
    {
        if (sizeBytes < 1024)
            return $"{sizeBytes} Б";
        if (sizeBytes < 1024 * 1024)
            return $"{sizeBytes / 1024.0:F1} КБ";
        return $"{sizeBytes / (1024.0 * 1024.0):F2} МБ";
    }
}