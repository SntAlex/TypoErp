@page "/products"
@attribute [Authorize]
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject IProductsWorkspaceCircuitSession WorkspaceSession
@inject IProductCatalogQueryService CatalogQueryService
@inject IProductSyncService ProductSyncService
@inject ISnackbar Snackbar

<PageTitle>Товары — TypoErp</PageTitle>

@if (!_canViewProducts)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
        У вашей учетной записи нет разрешения на просмотр раздела «Товары» (@nameof(AppPermission.ProductsView)).
        Обратитесь к администратору для делегирования прав.
    </MudAlert>
}
else
{
    <ProductsWorkspaceLockBanner />

    @if (_lookups is not null && !_lookups.IsStorageRootAccessible)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
            <MudText Typo="Typo.subtitle1"><b>Хранилище товаров недоступно!</b></MudText>
            <MudText Typo="Typo.body2">
                Корневой путь хранилища <code>@_lookups.StorageRootPath</code> не существует или недоступен для чтения/записи.
                Операции синхронизации и редактирования товаров заблокированы до восстановления доступа к диску.
            </MudText>
        </MudAlert>
    }

    <!-- Заголовок раздела, счетчики и панель синхронизации -->
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
            <div>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.h5">Каталог товаров</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                        Всего: @_totalAllProducts
                    </MudChip>
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="Color.Success"
                             Variant="@(_validityFilter == ProductValidityFilter.ValidOnly ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => SetQuickValidityFilterAsync(ProductValidityFilter.ValidOnly))">
                        Валидных: @_totalValidProducts
                    </MudChip>
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(_totalInvalidProducts > 0 ? Color.Error : Color.Default)"
                             Variant="@(_validityFilter == ProductValidityFilter.InvalidOnly ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => SetQuickValidityFilterAsync(ProductValidityFilter.InvalidOnly))">
                        Невалидных / черновиков: @_totalInvalidProducts
                    </MudChip>
                </MudStack>
                @if (_lookups is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Путь хранилища: <code>@_lookups.StorageRootPath</code>
                    </MudText>
                }
            </div>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="_isSynchronizing"
                           OnClick="RefreshCatalogAsync">
                    Обновить таблицу
                </MudButton>

                @if (_canSyncProducts)
                {
                    @if (IsHeldByCurrentSession)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Sync"
                                   Disabled="@(_isSynchronizing || (_lookups is not null && !_lookups.IsStorageRootAccessible))"
                                   OnClick="RunSynchronizationAsync">
                            @(_isSynchronizing ? "Синхронизация..." : "Синхронизировать с диском")
                        </MudButton>
                    }
                    else if (WorkspaceSession.CurrentLock is null)
                    {
                        <MudTooltip Text="Автоматически захватит свободную блокировку раздела и запустит синхронизацию с диском">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.SyncLock"
                                       Disabled="@(_isSynchronizing || (_lookups is not null && !_lookups.IsStorageRootAccessible))"
                                       OnClick="AcquireLockAndSynchronizeAsync">
                                Захватить лок и синхронизировать
                            </MudButton>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudTooltip Text="Для запуска синхронизации необходимо удерживать блокировку раздела «Товары»">
                            <span>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.SyncDisabled"
                                           Disabled="true">
                                    Синхронизировать с диском
                                </MudButton>
                            </span>
                        </MudTooltip>
                    }
                }
            </MudStack>
        </MudStack>

        @if (_isSynchronizing)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-3" />
        }

        @if (_lastSyncResult is not null)
        {
            <MudAlert Severity="@(_lastSyncResult.InvalidProducts > 0 || _lastSyncResult.NormalizationConflictsCount > 0 ? Severity.Warning : Severity.Success)"
                      Variant="Variant.Outlined"
                      Dense="true"
                      Class="mt-3"
                      ShowCloseIcon="true"
                      CloseIconClicked="@(() => _lastSyncResult = null)">
                <MudText Typo="Typo.subtitle2">
                    Синхронизация завершена в @_lastSyncResult.SynchronizedAtUtc.ToLocalTime().ToString("HH:mm:ss"):
                    всего товаров <b>@_lastSyncResult.TotalProducts</b>
                    (валидных: <b>@_lastSyncResult.ValidProducts</b>, с ошибками/черновиков: <b>@_lastSyncResult.InvalidProducts</b>).
                </MudText>
                <MudText Typo="Typo.caption">
                    Товары: +@_lastSyncResult.AddedProducts новых, ~@_lastSyncResult.UpdatedProducts обновлено, -@_lastSyncResult.DeletedProducts удалено |
                    Авто-нормализовано имен на диске: <b>@_lastSyncResult.AutoNormalizedItemsCount</b> (конфликтов: <b>@_lastSyncResult.NormalizationConflictsCount</b>) |
                    Файлы (XxHash64 diff): изменено @_lastSyncResult.AddedOrUpdatedFilesCount, без изменений @_lastSyncResult.UnchangedFilesCount, удалено @_lastSyncResult.DeletedFilesCount.
                </MudText>
            </MudAlert>
        }
    </MudPaper>

    <!-- Панель фильтрации и поиска -->
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4">
                <MudTextField T="string"
                              Value="_searchText"
                              ValueChanged="OnSearchTextChangedAsync"
                              Label="Поиск (артикул, теги, категория, формат, файлы)"
                              Placeholder="Например: 45к снежинка..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true"
                              Immediate="false"
                              DebounceInterval="300" />
            </MudItem>

            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="ProductValidityFilter"
                           Value="_validityFilter"
                           ValueChanged="OnValidityFilterChangedAsync"
                           Label="Статус валидности"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">
                    <MudSelectItem Value="ProductValidityFilter.All">Все товары</MudSelectItem>
                    <MudSelectItem Value="ProductValidityFilter.ValidOnly">Только валидные</MudSelectItem>
                    <MudSelectItem Value="ProductValidityFilter.InvalidOnly">Только с ошибками / черновики</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="Guid?"
                           Value="_selectedPrimaryTagId"
                           ValueChanged="OnPrimaryTagChangedAsync"
                           Label="Первичный тег (папка 1-го уровня)"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true">
                    @if (_lookups is not null)
                    {
                        @foreach (var tag in _lookups.PrimaryTags)
                        {
                            <MudSelectItem T="Guid?" Value="@tag.Id">@tag.Name (@tag.ProductsCount)</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="Guid?"
                           Value="_selectedCategoryId"
                           ValueChanged="OnCategoryChangedAsync"
                           Label="Категория (префикс сборки)"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true">
                    @if (_lookups is not null)
                    {
                        @foreach (var category in _lookups.Categories)
                        {
                            <MudSelectItem T="Guid?" Value="@category.Id">@category.DisplayLabel (@category.ProductsCount)</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="Guid?"
                           Value="_selectedFormatId"
                           ValueChanged="OnFormatChangedAsync"
                           Label="Формат"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true">
                    @foreach (var format in GetAvailableFormats())
                    {
                        <MudSelectItem T="Guid?" Value="@format.Id">@format.DisplayLabel (@format.ProductsCount)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudSelect T="Guid"
                           SelectedValues="_selectedSecondaryTagIds"
                           SelectedValuesChanged="OnSecondaryTagsChangedAsync"
                           Label="Непервичные теги (товар / категория / формат)"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           MultiSelection="true"
                           ToStringFunc="GetSecondaryTagNameById"
                           Clearable="true">
                    @if (_lookups is not null)
                    {
                        @foreach (var secTag in _lookups.SecondaryTags)
                        {
                            <MudSelectItem T="Guid" Value="@secTag.Id">@secTag.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="8" md="3">
                <MudSelect T="ProductValidationError?"
                           Value="_selectedValidationError"
                           ValueChanged="OnValidationErrorFilterChangedAsync"
                           Label="Конкретная ошибка валидации"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true">
                    @foreach (var err in Enum.GetValues<ProductValidationError>())
                    {
                        <MudSelectItem T="ProductValidationError?" Value="@err">
                            @ProductValidationErrorDescriptor.GetShortTitle(err)
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="4" md="2" Class="d-flex align-center">
                <MudButton Variant="Variant.Text"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.FilterAltOff"
                           Disabled="@(!HasActiveFilters)"
                           FullWidth="true"
                           OnClick="ResetFiltersAsync">
                    Сбросить фильтры
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Главная таблица товаров (MudDataGrid) -->
    <MudDataGrid T="ProductCatalogItemDto"
                 @ref="_dataGrid"
                 ServerData="LoadGridDataAsync"
                 Hover="true"
                 Dense="true"
                 Striped="true"
                 Elevation="1">
        <Columns>
            <HierarchyColumn T="ProductCatalogItemDto" />

            <TemplateColumn Title="Статус и ошибки" SortBy="x => x.IsValid" Sortable="true">
                <CellTemplate>
                    @if (context.Item.IsValid)
                    {
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="Color.Success"
                                 Icon="@Icons.Material.Filled.CheckCircle">
                            Валиден
                        </MudChip>
                    }
                    else if (context.Item.IsDraftOnly)
                    {
                        <MudTooltip Text="@ProductValidationErrorDescriptor.GetDescription(ProductValidationError.MissingAssemblyFiles)">
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="Color.Warning"
                                     Icon="@Icons.Material.Filled.EditNote">
                                Черновик (нет сборки)
                            </MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudStack Spacing="1">
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="Color.Error"
                                     Icon="@Icons.Material.Filled.Error">
                                Ошибок: @context.Item.ValidationErrors.Count
                            </MudChip>
                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                @foreach (var error in context.Item.ValidationErrors)
                                {
                                    <MudTooltip Text="@ProductValidationErrorDescriptor.GetDescription(error)">
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="Color.Error"
                                                 Variant="Variant.Outlined">
                                            @ProductValidationErrorDescriptor.GetShortTitle(error)
                                        </MudChip>
                                    </MudTooltip>
                                }
                            </MudStack>
                        </MudStack>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Первичный тег" SortBy="x => x.PrimaryTagName" Sortable="true">
                <CellTemplate>
                    @if (!string.IsNullOrWhiteSpace(context.Item.PrimaryTagName))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                            @context.Item.PrimaryTagName
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">
                            &lt;Вне первичного тега&gt;
                        </MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>

            <PropertyColumn Property="x => x.Article" Title="Артикул" Sortable="true">
                <CellTemplate>
                    <MudText Typo="Typo.body2"><b>@context.Item.Article</b></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        ID: @context.Item.Id.ToString("D")[..8]…
                    </MudText>
                </CellTemplate>
            </PropertyColumn>

            <TemplateColumn Title="Категория" SortBy="x => x.CategoryCode" Sortable="true">
                <CellTemplate>
                    @if (!string.IsNullOrWhiteSpace(context.Item.CategoryCode))
                    {
                        <MudText Typo="Typo.body2">@context.Item.CategoryLabel</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Формат" SortBy="x => x.FormatCode" Sortable="true">
                <CellTemplate>
                    @if (!string.IsNullOrWhiteSpace(context.Item.FormatCode))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                            @context.Item.FormatCode
                        </MudChip>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Непервичные теги" Sortable="false">
                <CellTemplate>
                    @if (context.Item.SecondaryTags.Count == 0 && context.Item.InheritedSecondaryTags.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                    }
                    else
                    {
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            @foreach (var tag in context.Item.SecondaryTags)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled">
                                    @tag
                                </MudChip>
                            }
                            @foreach (var inherited in context.Item.InheritedSecondaryTags)
                            {
                                <MudTooltip Text="Унаследован от категории или формата">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                        @inherited
                                    </MudChip>
                                </MudTooltip>
                            }
                        </MudStack>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Файлы" SortBy="x => x.Files.Count" Sortable="true">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@(context.Item.AssemblyFilesCount > 0 ? Color.Primary : Color.Default)"
                                 Variant="Variant.Outlined">
                            Сборка: @context.Item.AssemblyFilesCount
                        </MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                            Фото: @context.Item.CoversCount
                        </MudChip>
                        @if (context.Item.VideoCoversCount > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                Видео: @context.Item.VideoCoversCount
                            </MudChip>
                        }
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>

            <PropertyColumn Property="x => x.UpdatedAtUtc" Title="Обновлено" Sortable="true">
                <CellTemplate>
                    <MudText Typo="Typo.caption">
                        @context.Item.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </MudText>
                </CellTemplate>
            </PropertyColumn>
        </Columns>

        <ChildRowContent>
            <MudPaper Class="pa-4 ma-2" Elevation="0" Outlined="true">
                <MudGrid Spacing="3">
                    <MudItem xs="12">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.subtitle1">
                                <b>Детали товара:</b> @(context.Item.PrimaryTagName ?? "<корень>") / @context.Item.Article
                            </MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                .typoerp_id: @context.Item.Id
                            </MudChip>
                        </MudStack>
                    </MudItem>

                    @if (!context.Item.IsValid)
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="@(context.Item.IsDraftOnly ? Severity.Warning : Severity.Error)"
                                      Variant="Variant.Outlined"
                                      Dense="true">
                                <MudText Typo="Typo.subtitle2" Class="mb-1">
                                    Причины невалидности товара (@context.Item.ValidationErrors.Count):
                                </MudText>
                                <ul class="my-0 pl-4">
                                    @foreach (var err in context.Item.ValidationErrors)
                                    {
                                        <li>
                                            <b>@ProductValidationErrorDescriptor.GetShortTitle(err) (@err):</b>
                                            @ProductValidationErrorDescriptor.GetDescription(err)
                                        </li>
                                    }
                                </ul>
                            </MudAlert>
                        </MudItem>
                    }

                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            Файлы в папке товара (@context.Item.Files.Count):
                        </MudText>
                        @if (context.Item.Files.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                В папке товара нет неигнорируемых файлов.
                            </MudText>
                        }
                        else
                        {
                            <MudSimpleTable Dense="true" Hover="true" Bordered="true">
                                <thead>
                                    <tr>
                                        <th>Имя файла</th>
                                        <th>Тип</th>
                                        <th>Префикс</th>
                                        <th>Расширение</th>
                                        <th>Размер</th>
                                        <th>XxHash64</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var file in context.Item.Files)
                                    {
                                        <tr>
                                            <td><code>@file.FileName</code></td>
                                            <td>@GetFileKindLabel(file.Kind)</td>
                                            <td><code>@file.Prefix</code></td>
                                            <td><code>@file.Extension</code></td>
                                            <td>@FormatFileSize(file.SizeBytes)</td>
                                            <td><code>@file.XxHash64</code></td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </ChildRowContent>

        <NoRecordsContent>
            <MudStack AlignItems="AlignItems.Center" Class="pa-6" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.subtitle1">Товары не найдены</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Попробуйте изменить параметры поиска или запустите синхронизацию с файловым хранилищем.
                </MudText>
            </MudStack>
        </NoRecordsContent>

        <PagerContent>
            <MudDataGridPager T="ProductCatalogItemDto" PageSizeOptions="new[] { 10, 25, 50, 100 }" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    private MudDataGrid<ProductCatalogItemDto>? _dataGrid;
    private ProductCatalogLookups? _lookups;
    private ProductSyncResult? _lastSyncResult;

    private Guid _currentUserId;
    private string _currentUserDisplayName = "Работник";
    private bool _canViewProducts;
    private bool _canSyncProducts;
    private bool _isSynchronizing;

    private int _totalAllProducts;
    private int _totalValidProducts;
    private int _totalInvalidProducts;

    private string? _searchText;
    private ProductValidityFilter _validityFilter = ProductValidityFilter.All;
    private Guid? _selectedPrimaryTagId;
    private Guid? _selectedCategoryId;
    private Guid? _selectedFormatId;
    private IReadOnlyCollection<Guid> _selectedSecondaryTagIds = Array.Empty<Guid>();
    private ProductValidationError? _selectedValidationError;

    private bool IsHeldByCurrentSession =>
        WorkspaceSession.CurrentLock is not null
        && string.Equals(
            WorkspaceSession.CurrentLock.SessionId,
            WorkspaceSession.SessionId,
            StringComparison.Ordinal
        );

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchText)
        || _validityFilter != ProductValidityFilter.All
        || _selectedPrimaryTagId.HasValue
        || _selectedCategoryId.HasValue
        || _selectedFormatId.HasValue
        || _selectedSecondaryTagIds.Count > 0
        || _selectedValidationError.HasValue;

    protected override async Task OnInitializedAsync()
    {
        WorkspaceSession.StateChanged += OnWorkspaceSessionStateChanged;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(userIdClaim, out var parsedUserId))
            _currentUserId = parsedUserId;

        _currentUserDisplayName =
            user.FindFirst(c => c.Type.Contains("display", StringComparison.OrdinalIgnoreCase))?.Value
            ?? user.Identity?.Name
            ?? "Работник";

        _canViewProducts = user.HasPermission(AppPermission.ProductsView);
        _canSyncProducts = user.HasPermission(AppPermission.ProductsSync);

        if (_canViewProducts)
            await LoadLookupsAsync();
    }

    private async Task LoadLookupsAsync()
    {
        _lookups = await CatalogQueryService.GetFilterLookupsAsync();
        _totalAllProducts = _lookups.TotalProductsCount;
        _totalValidProducts = _lookups.ValidProductsCount;
        _totalInvalidProducts = _lookups.InvalidProductsCount;
    }

    private async Task<GridData<ProductCatalogItemDto>> LoadGridDataAsync(
        GridState<ProductCatalogItemDto> state,
        CancellationToken cancellationToken
    )
    {
        var sortDefinition = state.SortDefinitions.FirstOrDefault();
        var sortField = ResolveSortField(sortDefinition?.SortBy);
        var sortDescending = sortDefinition?.Descending ?? false;

        var filter = new ProductCatalogFilter(
            SearchText: _searchText,
            Validity: _validityFilter,
            PrimaryTagId: _selectedPrimaryTagId,
            CategoryId: _selectedCategoryId,
            FormatId: _selectedFormatId,
            SecondaryTagIds: _selectedSecondaryTagIds,
            ValidationError: _selectedValidationError,
            SortBy: sortField,
            SortDescending: sortDescending,
            Page: state.Page,
            PageSize: state.PageSize
        );

        var pageResult = await CatalogQueryService.QueryProductsAsync(filter, cancellationToken);

        _totalAllProducts = pageResult.TotalAllProductsCount;
        _totalValidProducts = pageResult.TotalValidProductsCount;
        _totalInvalidProducts = pageResult.TotalInvalidProductsCount;

        return new GridData<ProductCatalogItemDto>
        {
            Items = pageResult.Items,
            TotalItems = pageResult.TotalMatchedCount,
        };
    }

    private async Task RefreshCatalogAsync()
    {
        await LoadLookupsAsync();
        if (_dataGrid is not null)
            await _dataGrid.ReloadServerData();
    }

    private async Task AcquireLockAndSynchronizeAsync()
    {
        if (_currentUserId == Guid.Empty)
        {
            Snackbar.Add("Не удалось определить идентификатор текущего работника.", Severity.Error);
            return;
        }

        var acquireResult = WorkspaceSession.TryAcquire(_currentUserId, _currentUserDisplayName);
        if (!acquireResult.IsAcquired)
        {
            Snackbar.Add(
                $"Не удалось захватить блокировку: раздел уже занят работником «{acquireResult.CurrentLock.UserDisplayName}».",
                Severity.Warning
            );
            return;
        }

        await RunSynchronizationAsync();
    }

    private async Task RunSynchronizationAsync()
    {
        if (_isSynchronizing)
            return;

        _isSynchronizing = true;
        StateHasChanged();

        try
        {
            _lastSyncResult = await ProductSyncService.SynchronizeAsync(WorkspaceSession.SessionId);
            await RefreshCatalogAsync();

            var severity =
                _lastSyncResult.InvalidProducts > 0
                || _lastSyncResult.NormalizationConflictsCount > 0
                    ? Severity.Warning
                    : Severity.Success;

            Snackbar.Add(
                $"Синхронизация завершена: товаров {_lastSyncResult.TotalProducts} (валидных: {_lastSyncResult.ValidProducts}, с ошибками: {_lastSyncResult.InvalidProducts}).",
                severity
            );
        }
        catch (ProductsWorkspaceLockException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка синхронизации хранилища: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSynchronizing = false;
            await LoadLookupsAsync();
            StateHasChanged();
        }
    }

    private IReadOnlyList<FormatLookupDto> GetAvailableFormats()
    {
        if (_lookups is null)
            return [];

        if (_selectedCategoryId.HasValue)
            return _lookups
                .Formats.Where(f => f.CategoryId == _selectedCategoryId.Value)
                .ToList();

        return _lookups.Formats;
    }

    private string GetSecondaryTagNameById(Guid id)
    {
        return _lookups?.SecondaryTags.FirstOrDefault(t => t.Id == id)?.Name ?? id.ToString();
    }

    private async Task OnSearchTextChangedAsync(string? value)
    {
        _searchText = value;
        await ReloadGridAsync();
    }

    private async Task OnValidityFilterChangedAsync(ProductValidityFilter value)
    {
        _validityFilter = value;
        await ReloadGridAsync();
    }

    private async Task SetQuickValidityFilterAsync(ProductValidityFilter targetFilter)
    {
        _validityFilter =
            _validityFilter == targetFilter ? ProductValidityFilter.All : targetFilter;
        await ReloadGridAsync();
    }

    private async Task OnPrimaryTagChangedAsync(Guid? value)
    {
        _selectedPrimaryTagId = value;
        await ReloadGridAsync();
    }

    private async Task OnCategoryChangedAsync(Guid? value)
    {
        _selectedCategoryId = value;
        if (
            _selectedFormatId.HasValue
            && _lookups is not null
            && !_lookups.Formats.Any(f =>
                f.Id == _selectedFormatId.Value
                && (!value.HasValue || f.CategoryId == value.Value)
            )
        )
        {
            _selectedFormatId = null;
        }

        await ReloadGridAsync();
    }

    private async Task OnFormatChangedAsync(Guid? value)
    {
        _selectedFormatId = value;
        await ReloadGridAsync();
    }

    private async Task OnSecondaryTagsChangedAsync(IEnumerable<Guid> values)
    {
        _selectedSecondaryTagIds = values?.ToArray() ?? Array.Empty<Guid>();
        await ReloadGridAsync();
    }

    private async Task OnValidationErrorFilterChangedAsync(ProductValidationError? value)
    {
        _selectedValidationError = value;
        await ReloadGridAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _searchText = null;
        _validityFilter = ProductValidityFilter.All;
        _selectedPrimaryTagId = null;
        _selectedCategoryId = null;
        _selectedFormatId = null;
        _selectedSecondaryTagIds = Array.Empty<Guid>();
        _selectedValidationError = null;

        await ReloadGridAsync();
    }

    private async Task ReloadGridAsync()
    {
        if (_dataGrid is not null)
            await _dataGrid.ReloadServerData();
    }

    private static ProductCatalogSortField ResolveSortField(string? sortBy)
    {
        if (string.IsNullOrWhiteSpace(sortBy))
            return ProductCatalogSortField.Article;

        if (sortBy.Contains(nameof(ProductCatalogItemDto.PrimaryTagName), StringComparison.Ordinal))
            return ProductCatalogSortField.PrimaryTag;
        if (sortBy.Contains(nameof(ProductCatalogItemDto.CategoryCode), StringComparison.Ordinal))
            return ProductCatalogSortField.Category;
        if (sortBy.Contains(nameof(ProductCatalogItemDto.FormatCode), StringComparison.Ordinal))
            return ProductCatalogSortField.Format;
        if (sortBy.Contains(nameof(ProductCatalogItemDto.IsValid), StringComparison.Ordinal))
            return ProductCatalogSortField.Validity;
        if (sortBy.Contains(nameof(ProductCatalogItemDto.Files), StringComparison.Ordinal))
            return ProductCatalogSortField.FilesCount;
        if (sortBy.Contains(nameof(ProductCatalogItemDto.UpdatedAtUtc), StringComparison.Ordinal))
            return ProductCatalogSortField.UpdatedAtUtc;

        return ProductCatalogSortField.Article;
    }

    private static string GetFileKindLabel(ProductFileKind kind)
    {
        return kind switch
        {
            ProductFileKind.Cover => "Обложка (cover)",
            ProductFileKind.VideoCover => "Видеообложка (video)",
            ProductFileKind.AssemblyFile => "Файл сборки",
            _ => "Игнорируемый",
        };
    }

    private static string FormatFileSize(long sizeBytes)
    {
        if (sizeBytes < 1024)
            return $"{sizeBytes} Б";

        var kb = sizeBytes / 1024.0;
        if (kb < 1024)
            return $"{kb:F1} КБ";

        var mb = kb / 1024.0;
        return $"{mb:F2} МБ";
    }

    private void OnWorkspaceSessionStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        WorkspaceSession.StateChanged -= OnWorkspaceSessionStateChanged;
    }
}