@inject IUserManagementService UserManagementService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Class="mr-2 mb-n1" />
            Смена собственного пароля
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_errorMessage</MudAlert>
        }

        <MudTextField @bind-Value="_currentPassword"
                      Label="Текущий пароль"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Required="true"
                      Class="mb-3" />

        <MudTextField @bind-Value="_newPassword"
                      Label="Новый пароль (не менее 6 символов)"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Required="true"
                      Class="mb-3" />

        <MudTextField @bind-Value="_confirmPassword"
                      Label="Подтверждение нового пароля"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Required="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isSubmitting">Отмена</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SubmitAsync"
                   Disabled="_isSubmitting">
            Сохранить пароль
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Guid UserId { get; set; }

    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _errorMessage;
    private bool _isSubmitting;

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        _errorMessage = null;

        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            _errorMessage = "Новый пароль и его подтверждение не совпадают.";
            return;
        }

        _isSubmitting = true;
        try
        {
            await UserManagementService.ChangeOwnPasswordAsync(UserId, _currentPassword, _newPassword);
            Snackbar.Add("Пароль успешно изменен.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (IdentityManagementException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}