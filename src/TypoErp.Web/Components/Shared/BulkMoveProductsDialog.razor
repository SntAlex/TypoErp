@inject IProductManagementService ManagementService
@inject ProductsStorageOptions StorageOptions
@inject ISnackbar Snackbar

<MudDialog Visible="@Visible" VisibleChanged="@HandleVisibleChangedAsync" Options="@_dialogOptions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.DriveFileMove" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Массовый перенос товаров (@ProductIds.Count шт.)</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3" Class="py-1">
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true">
                    @_errorMessage
                </MudAlert>
            }

            <MudText Typo="Typo.body2">
                Выберите существующий первичный тег или введите название новой папки 1-го уровня. Папки выбранных товаров будут физически перемещены на диске и перепривязаны в БД.
            </MudText>

            <MudTextField T="string"
                          @bind-Value="_targetPrimaryTag"
                          Label="Целевой первичный тег"
                          Placeholder="Например: архив 2026"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          HelperText="@($"Нормализованное имя: «{StringNormalizer.Normalize(_targetPrimaryTag)}»")" />

            @if (AvailablePrimaryTags.Count > 0)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Существующие первичные теги:</MudText>
                    @foreach (var tag in AvailablePrimaryTags)
                    {
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="Color.Primary"
                                 Variant="@(string.Equals(StringNormalizer.Normalize(_targetPrimaryTag), tag.NormalizedName, StringComparison.Ordinal) ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => _targetPrimaryTag = tag.Name)">
                            @tag.Name (@tag.ProductsCount)
                        </MudChip>
                    }
                </MudStack>
            }
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="@_isBusy" OnClick="CloseAsync">Отмена</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.DriveFileMove"
                   Disabled="@(_isBusy || !PrimaryTagValidator.Validate(_targetPrimaryTag, StorageOptions).IsValid)"
                   OnClick="ExecuteMoveAsync">
            @(_isBusy ? "Перемещение..." : $"Перенести ({ProductIds.Count})")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseButton = true,
    };

    private string _targetPrimaryTag = string.Empty;
    private string? _errorMessage;
    private bool _isBusy;
    private bool _wasVisible;

    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter]
    public string SessionId { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyCollection<Guid> ProductIds { get; set; } = [];

    [Parameter]
    public IReadOnlyList<PrimaryTagLookupDto> AvailablePrimaryTags { get; set; } = [];

    [Parameter]
    public EventCallback<BulkMoveProductsResult> OnCompleted { get; set; }

    protected override void OnParametersSet()
    {
        if (Visible && !_wasVisible)
        {
            _errorMessage = null;
            _isBusy = false;
            _targetPrimaryTag = AvailablePrimaryTags.FirstOrDefault()?.Name ?? string.Empty;
            _wasVisible = true;
        }
        else if (!Visible)
        {
            _wasVisible = false;
        }
    }

    private async Task ExecuteMoveAsync()
    {
        _errorMessage = null;
        _isBusy = true;

        try
        {
            var result = await ManagementService.BulkMoveProductsAsync(
                SessionId,
                ProductIds,
                _targetPrimaryTag
            );

            Snackbar.Add(
                $"Перенесено товаров в «{result.NormalizedTargetPrimaryTag}»: {result.MovedProductsCount}.",
                Severity.Success
            );

            await OnCompleted.InvokeAsync(result);
            await CloseAsync();
        }
        catch (Exception ex) when (ex is ProductManagementException or ProductsWorkspaceLockException)
        {
            _errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ошибка при массовом переносе: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private Task HandleVisibleChangedAsync(bool nextVisible)
    {
        Visible = nextVisible;
        return VisibleChanged.InvokeAsync(nextVisible);
    }

    private Task CloseAsync() => HandleVisibleChangedAsync(false);
}