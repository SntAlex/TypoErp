@inject IProductManagementService ManagementService
@inject ISnackbar Snackbar

<MudDialog Visible="@Visible" VisibleChanged="@HandleVisibleChangedAsync" Options="@_dialogOptions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Label" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Массовое изменение непервичных тегов (@ProductIds.Count шт.)</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3" Class="py-1">
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true">
                    @_errorMessage
                </MudAlert>
            }

            <MudSelect T="BulkSecondaryTagOperationMode"
                       @bind-Value="_mode"
                       Label="Режим операции"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                <MudSelectItem T="BulkSecondaryTagOperationMode" Value="BulkSecondaryTagOperationMode.Add">
                    Добавить указанные теги к текущим
                </MudSelectItem>
                <MudSelectItem T="BulkSecondaryTagOperationMode" Value="BulkSecondaryTagOperationMode.Remove">
                    Удалить указанные теги у выбранных товаров
                </MudSelectItem>
                <MudSelectItem T="BulkSecondaryTagOperationMode" Value="BulkSecondaryTagOperationMode.Replace">
                    Полностью заменить теги выбранных товаров на указанный список
                </MudSelectItem>
            </MudSelect>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudTextField T="string"
                              @bind-Value="_newTagInput"
                              Label="Новый или существующий тег"
                              Placeholder="Например: сезонный товар"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true" />
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddTagFromInput">
                    Добавить
                </MudButton>
            </MudStack>

            <MudPaper Outlined="true" Class="pa-2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Выбранные для операции теги:</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                    @if (_selectedTags.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @(_mode == BulkSecondaryTagOperationMode.Replace
                                ? "Список пуст — при замене у выбранных товаров будут очищены все прямые непервичные теги."
                                : "Выберите хотя бы один тег ниже или добавьте вручную.")
                        </MudText>
                    }
                    @foreach (var tag in _selectedTags.OrderBy(t => t, StringComparer.Ordinal))
                    {
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="Color.Primary"
                                 Variant="Variant.Filled"
                                 OnClose="@(() => _selectedTags.Remove(tag))">
                            @tag
                        </MudChip>
                    }
                </MudStack>
            </MudPaper>

            @if (AvailableSecondaryTags.Count > 0)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Справочник непервичных тегов:</MudText>
                    @foreach (var lookup in AvailableSecondaryTags)
                    {
                        var isSelected = _selectedTags.Contains(lookup.Name);
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@(isSelected ? Color.Primary : Color.Default)"
                                 Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => ToggleTag(lookup.Name))">
                            @lookup.Name (@lookup.ProductsCount)
                        </MudChip>
                    }
                </MudStack>
            }
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="@_isBusy" OnClick="CloseAsync">Отмена</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Check"
                   Disabled="@(_isBusy || (_mode != BulkSecondaryTagOperationMode.Replace && _selectedTags.Count == 0))"
                   OnClick="ExecuteUpdateTagsAsync">
            @(_isBusy ? "Применение..." : "Применить")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseButton = true,
    };

    private BulkSecondaryTagOperationMode _mode = BulkSecondaryTagOperationMode.Add;
    private string _newTagInput = string.Empty;
    private readonly HashSet<string> _selectedTags = new(StringComparer.Ordinal);
    private string? _errorMessage;
    private bool _isBusy;
    private bool _wasVisible;

    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter]
    public string SessionId { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyCollection<Guid> ProductIds { get; set; } = [];

    [Parameter]
    public IReadOnlyList<SecondaryTagLookupDto> AvailableSecondaryTags { get; set; } = [];

    [Parameter]
    public EventCallback<int> OnCompleted { get; set; }

    protected override void OnParametersSet()
    {
        if (Visible && !_wasVisible)
        {
            _errorMessage = null;
            _isBusy = false;
            _mode = BulkSecondaryTagOperationMode.Add;
            _newTagInput = string.Empty;
            _selectedTags.Clear();
            _wasVisible = true;
        }
        else if (!Visible)
        {
            _wasVisible = false;
        }
    }

    private void AddTagFromInput()
    {
        var normalized = StringNormalizer.Normalize(_newTagInput);
        if (string.IsNullOrEmpty(normalized))
            return;

        _selectedTags.Add(normalized);
        _newTagInput = string.Empty;
    }

    private void ToggleTag(string tagName)
    {
        var normalized = StringNormalizer.Normalize(tagName);
        if (string.IsNullOrEmpty(normalized))
            return;

        if (!_selectedTags.Remove(normalized))
            _selectedTags.Add(normalized);
    }

    private async Task ExecuteUpdateTagsAsync()
    {
        _errorMessage = null;
        _isBusy = true;

        try
        {
            var updatedCount = await ManagementService.BulkUpdateProductSecondaryTagsAsync(
                SessionId,
                ProductIds,
                _selectedTags.ToList(),
                _mode
            );

            Snackbar.Add(
                $"Непервичные теги обновлены для {updatedCount} товаров.",
                Severity.Success
            );

            await OnCompleted.InvokeAsync(updatedCount);
            await CloseAsync();
        }
        catch (Exception ex) when (ex is ProductManagementException or ProductsWorkspaceLockException)
        {
            _errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ошибка при обновлении тегов: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private Task HandleVisibleChangedAsync(bool nextVisible)
    {
        Visible = nextVisible;
        return VisibleChanged.InvokeAsync(nextVisible);
    }

    private Task CloseAsync() => HandleVisibleChangedAsync(false);
}